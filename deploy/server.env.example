# /opt/momentum/.env on the server. Readable only by the deploy user (chmod 600). Never commit the real file.

# ---- Where the app lives ----
MOMENTUM_IMAGE=ghcr.io/YOUR-GITHUB-ORG/momentum
MOMENTUM_DOMAIN=momentum.jdlawyers.ca
PUBLIC_BASE_URL=https://momentum.jdlawyers.ca

# ---- Who's in charge ----
OWNER_EMAIL=jasmine@jdlawyers.ca

# ---- Google sign-in (GO-LIVE.md step 5) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow Google Workspace accounts on this domain (leave empty if some staff use other Google accounts).
GOOGLE_HOSTED_DOMAIN=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_HOURS=12

# ---- Backups to Akamai Object Storage (GO-LIVE.md step 4) ----
BACKUP_BUCKET=momentum-backups
BACKUP_ENDPOINT=https://REGION.linodeobjects.com
BACKUP_ACCESS_KEY=
BACKUP_SECRET_KEY=

# ---- Email through Amazon SES (GO-LIVE.md "Email sending"; leave as-is until then) ----
EMAIL_PROVIDER=ses
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=momentum
SES_TOPIC_ARN=
# Generate each with: openssl rand -base64 48
EMAIL_SIGNING_SECRET=
SES_WEBHOOK_TOKEN=
SEND_BATCH_SIZE=100