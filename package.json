{
  "name": "momentum",
  "private": true,
  "version": "0.1.0",
  "description": "Momentum: Jasmine Daya's private staff platform (JD&Co Law Firm and divisions).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --enable-source-maps dist/server/main.mjs",
    "check": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
